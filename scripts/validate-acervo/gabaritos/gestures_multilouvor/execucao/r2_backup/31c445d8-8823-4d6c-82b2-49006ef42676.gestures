{"schema":"coldigom.gestures/1","title":"40 - QUERO OUVIR (MEU QUERER)","dictionaryVersion":0,"items":[{"type":"gesture","gestureId":"4407bea7bf89","lyrics":[{"trigger":"Quero","text":"ouvir a tua voz ó meu Senhor,"}]},{"type":"gesture","gestureId":"37f56d504928","lyrics":[{"trigger":"A falar","text":"tão pura e meiga ao coração."}]},{"type":"gesture","gestureId":"121dceda600f","lyrics":[{"trigger":"E sentir","text":"o toque do teu Santo Espirito"}]},{"type":"gesture","gestureId":"c687580e7682","lyrics":[{"trigger":"Pra que","text":"eu possa renovar a comunhão"}]},{"type":"coro","children":[{"type":"repeat","count":2,"children":[{"type":"gesture","gestureId":"a1ae90ec4622","lyrics":[{"trigger":"Quero","text":"louvar, com alegria em meu viver"}]},{"type":"gesture","gestureId":"c687580e7682","lyrics":[{"trigger":"Renovar","text":"a minha fé"}]},{"type":"gesture","gestureId":"860ff1ab2150","lyrics":[{"trigger":"Entregar","text":"todo o meu ser."}]}]}]},{"type":"instruction","kind":"instruments"},{"type":"gesture","gestureId":"5b15aaadaa96","lyrics":[{"trigger":"Quero","text":"falar desse seu imenso amor."}]},{"type":"gesture","gestureId":"b50f29acc333","lyrics":[{"trigger":"E dizer","text":"a todo o mundo que Jesus é o Salvador."}]},{"type":"gesture","gestureId":"860ff1ab2150","lyrics":[{"trigger":"Que lá","text":"na cruz ele morreu"}]},{"type":"gesture","gestureId":"a70feedaefe5","lyrics":[{"trigger":"Pra","text":"nos salvar"}]},{"type":"gesture","gestureId":"dc9e1b347ac8","lyrics":[{"trigger":"Derramou","text":"seu sangue puro"}]},{"type":"gesture","gestureId":"a70feedaefe5","lyrics":[{"trigger":"E a vida","text":"eterna dá."}]},{"type":"instruction","kind":"back_to_chorus_and_finish"}]}