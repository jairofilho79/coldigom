{
  "name": "coldigom-api",
  "version": "1.0.0",
  "description": "Cloudflare Worker API for COLetanea DIGital Object Manager",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc",
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "d1:create": "wrangler d1 create coldigom",
    "d1:execute": "wrangler d1 execute coldigom --local --file=schema.sql",
    "d1:execute:remote": "wrangler d1 execute coldigom --remote --file=schema.sql",
    "ingest:dry-run": "tsx scripts/ingest.ts --dry-run",
    "ingest": "tsx scripts/ingest.ts",
    "ingest:execute": "tsx scripts/ingest.ts --execute",
    "test": "vitest"
  },
  "keywords": [
    "cloudflare",
    "worker",
    "hono",
    "d1",
    "r2"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5",
    "wrangler": "^4.84.1"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "jose": "^6.2.3",
    "js-yaml": "^4.1.0"
  }
}
