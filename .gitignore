# OS files
.DS_Store
**/.DS_Store
Thumbs.db

# Cursor (local IDE rules)
.cursor/

# Dependencies
node_modules/
.npm

# Build outputs
dist/
build/

# Relatórios de cobertura (regenerar: npm run coverage)
coverage/

# Environment files
.env
.env.local
.env.*.local
# web/.env.production NÃO é ignorado: não tem segredo (só VITE_API_URL vazio) e
# é a fonte única de verdade da origem da API entre o CI e o deploy manual.

# IDE
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Storage directory (data files)
storage/

# Cloudflare Workers
.wrangler/
.dev.vars

# Cloudflare wrangler config (contains credentials - use wrangler.toml.example)
api/wrangler.toml

# Vite
web/dist/

# Local R2 assets (uploaded separately to Cloudflare R2)
api/assets/

# Generated ingestion SQL (regenerate locally: cd api && npm run ingest)
ingestion.sql
ingestion_no_tx.sql

# Cloudflare migration artifacts (D1 backup, local secrets)
migration/

# Arquivo vazio que entrou por engano num `git add api` (S2). Não pertence ao repo.
api/.zshrc

# Kilo CLI internal files
.kilo/

.dev.vars*
!.dev.vars.example
!.env.example

