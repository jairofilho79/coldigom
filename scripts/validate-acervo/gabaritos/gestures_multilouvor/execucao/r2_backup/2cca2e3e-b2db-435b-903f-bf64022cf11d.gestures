{"schema":"coldigom.gestures/1","title":"37 - NO MEU CORAÇÃO HÁ UM TESOURO (PRÍNCIPE DA VIDA)","dictionaryVersion":0,"items":[{"type":"gesture","gestureId":"37f56d504928","lyrics":[{"trigger":"No","text":"meu coração há um tesouro."}]},{"type":"gesture","gestureId":"a1ae90ec4622","lyrics":[{"trigger":"O maior","text":"que possa existir."}]},{"type":"gesture","gestureId":"c687580e7682","lyrics":[{"trigger":"A melhor","text":"coisa que fiz foi encontrá-lo,"}]},{"type":"gesture","gestureId":"a70feedaefe5","lyrics":[{"trigger":"Pois","text":"vida eterna adquiri."}]},{"type":"gesture","gestureId":"121dceda600f","lyrics":[{"trigger":"Príncipe","text":"da Vida, Pai da Eternidade"}]},{"type":"gesture","gestureId":"37f56d504928","lyrics":[{"trigger":"É","text":"o meu tesouro,"}]},{"type":"gesture","gestureId":"121dceda600f","lyrics":[{"trigger":"Príncipe","text":"da Vida, Pai da Eternidade"}]},{"type":"gesture","gestureId":"37f56d504928","lyrics":[{"trigger":"É","text":"o meu tesouro, é o meu Jesus."}]}]}