{"schema":"coldigom.gestures/1","title":"19 - QUANDO DAVI AO SENHOR ORAVA","dictionaryVersion":0,"items":[{"type":"gesture","gestureId":"ce94a962b0e0","lyrics":[{"trigger":"Quando","text":"Davi ao Senhor orava,"}]},{"type":"gesture","gestureId":"9aa70529b54e","lyrics":[{"trigger":"Pra Jerusalém","text":"estava o seu olhar"}]},{"type":"gesture","gestureId":"b980f44702da","lyrics":[{"trigger":"Porque","text":"ele sabia que em Jerusalém"}]},{"type":"gesture","gestureId":"121dceda600f","lyrics":[{"trigger":"O nome","text":"do Senhor firmado está."}]},{"type":"gesture","gestureId":"b980f44702da","lyrics":[{"trigger":"Igual","text":"a Davi, também vou orar"}]},{"type":"gesture","gestureId":"8278b49bf967","lyrics":[{"trigger":"Olhando","text":"pra Jerusalém celestial,"}]},{"type":"gesture","gestureId":"e473b25ea89b","lyrics":[{"trigger":"A cidade","text":"de meu Rei e Senhor,"}]},{"type":"gesture","gestureId":"121dceda600f","lyrics":[{"trigger":"Que do","text":"seu trono irá a responder"}]},{"type":"gesture","gestureId":"b980f44702da","lyrics":[{"trigger":"a oração","text":"de seu servo fiel."}]},{"type":"gesture","gestureId":"c687580e7682","lyrics":[{"trigger":"Eu vou","text":"orar, eu vou orar porque eu sei que meu Senhor"}]},{"type":"gesture","gestureId":"4407bea7bf89","lyrics":[{"trigger":"vai me","text":"escutar."}]},{"type":"gesture","gestureId":"c687580e7682","lyrics":[{"trigger":"Eu vou","text":"orar, eu vou orar porque eu sei que meu Senhor"}]},{"type":"gesture","gestureId":"4407bea7bf89","lyrics":[{"trigger":"vai me","text":"escutar."}]},{"type":"instruction","kind":"repeat_praise"}]}