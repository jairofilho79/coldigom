name = "coldigom-api"
account_id = "${CLOUDFLARE_ACCOUNT_ID}"
main = "src/index.ts"
compatibility_date = "2024-01-01"
nodejs_compat = true

# D1 Database binding
[[d1_databases]]
binding = "DB"
database_name = "coldigom"
database_id = "${CLOUDFLARE_DATABASE_ID}"

# R2 Bucket binding
[[r2_buckets]]
binding = "ASSETS"
bucket_name = "coldigom-assets"

# Dev configuration (local development)
[dev]
port = 8787
local_protocol = "http"

# Build configuration
build.command = "npx tsc"