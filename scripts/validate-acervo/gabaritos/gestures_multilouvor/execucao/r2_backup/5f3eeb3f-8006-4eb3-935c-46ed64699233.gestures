{"schema":"coldigom.gestures/1","title":"232 - HOJE EU NÃO QUERO PEDIR","dictionaryVersion":0,"items":[{"type":"gesture","gestureId":"81338f2f401e","lyrics":[{"trigger":"Hoje","text":"eu não quero pedir nada a ti,"}]},{"type":"gesture","gestureId":"e7b821c9041a","lyrics":[{"trigger":"Eu","text":"só quero louvar, meu Senhor,"}]},{"type":"gesture","gestureId":"a1ae90ec4622","lyrics":[{"trigger":"Pois","text":"grandes coisas fizeste por mim"}]},{"type":"gesture","gestureId":"c687580e7682","lyrics":[{"trigger":"Por","text":"isso alegre estou."}]},{"type":"gesture","gestureId":"7e97e73482c6","lyrics":[{"trigger":"A noite","text":"já acabou, foi-se a dor,"}]},{"type":"gesture","gestureId":"a1ae90ec4622","lyrics":[{"trigger":"A alegria","text":"voltou em louvor;"}]},{"type":"gesture","gestureId":"ad1f9caa6887","lyrics":[{"trigger":"Tua","text":"palavra é fiel, creio assim,"}]},{"type":"gesture","gestureId":"a1ae90ec4622","lyrics":[{"trigger":"Por","text":"isso alegre estou."}]}]}