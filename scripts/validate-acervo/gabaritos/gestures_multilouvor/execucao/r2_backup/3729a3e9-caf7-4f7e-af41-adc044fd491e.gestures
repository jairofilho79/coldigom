{"schema":"coldigom.gestures/1","title":"95 - DO PÃO DO CÉU","dictionaryVersion":0,"items":[{"type":"gesture","gestureId":"b80645bc1198","lyrics":[{"trigger":"Do pão","text":"do céu me nutrirei,"}]},{"type":"gesture","gestureId":"6d88501c6888","lyrics":[{"trigger":"Da fonte","text":"eterna beberei;"}]},{"type":"gesture","gestureId":"b980f44702da","lyrics":[{"trigger":"“E quem","text":"beber”, nos diz Jesus, “Jamais de sede sofrerá”."}]},{"type":"gesture","gestureId":"81338f2f401e","lyrics":[{"trigger":"Não","text":"mais sede? Que dizeis?"}]},{"type":"gesture","gestureId":"81338f2f401e","lyrics":[{"trigger":"Não","text":"mais sede, assim será!"}]},{"type":"gesture","gestureId":"b980f44702da","lyrics":[{"trigger":"“E quem","text":"beber”, nos diz Jesus, “Jamais de sede sofrerá”."}]},{"type":"gesture","gestureId":"81338f2f401e","lyrics":[{"trigger":"Sede","text":"não terá!"}]}]}