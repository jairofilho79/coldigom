{"schema":"coldigom.gestures/1","title":"08 - DIANTE DO TEU ALTAR","dictionaryVersion":0,"items":[{"type":"gesture","gestureId":"121dceda600f","lyrics":[{"trigger":"Diante","text":"do teu altar, Senhor,"}]},{"type":"gesture","gestureId":"d8fca087f4bd","lyrics":[{"trigger":"Os meus","text":"joelhos vou dobrar"}]},{"type":"gesture","gestureId":"121dceda600f","lyrics":[{"trigger":"E por","text":"teu sangue vou clamar,"}]},{"type":"gesture","gestureId":"37f56d504928","lyrics":[{"trigger":"Pedindo:","text":"Vem purificar o meu coração, que espera em ti com gratidão!"}]},{"type":"repeat","count":2,"children":[{"type":"gesture","gestureId":"c687580e7682","lyrics":[{"trigger":"Eu clamo","text":"pela vida,"}]},{"type":"gesture","gestureId":"121dceda600f","lyrics":[{"trigger":"A vida","text":"que há em ti, Jesus! Pelo poder do sangue"}]},{"type":"gesture","gestureId":"dc9e1b347ac8","lyrics":[{"trigger":"vertido","text":"na cruz!"}]}]},{"type":"instruction","kind":"repeat_praise"}]}