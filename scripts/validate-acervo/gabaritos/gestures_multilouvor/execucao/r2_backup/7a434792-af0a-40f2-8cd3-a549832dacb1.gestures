{"schema":"coldigom.gestures/1","title":"201 - SOBRE AS NUVENS JESUS VEM","dictionaryVersion":0,"items":[{"type":"gesture","gestureId":"f5598e48ef67","lyrics":[{"trigger":"Sobre","text":"as nuvens Jesus vem"}]},{"type":"gesture","gestureId":"e7b821c9041a","lyrics":[{"trigger":"Como","text":"Rei e vencedor,"}]},{"type":"gesture","gestureId":"a70feedaefe5","lyrics":[{"trigger":"Sua","text":"igreja vem buscar"}]},{"type":"gesture","gestureId":"b50f29acc333","lyrics":[{"trigger":"Cumprindo","text":"sua promessa ao seu povo."}]},{"type":"repeat","count":2,"children":[{"type":"gesture","gestureId":"a1ae90ec4622","lyrics":[{"trigger":"Que alegria","text":"ver nosso Rei."}]},{"type":"gesture","gestureId":"4c6ef6eb0eac","lyrics":[{"trigger":"Maranata","text":", cantaremos com fervor,"}]},{"type":"gesture","gestureId":"e7b821c9041a","lyrics":[{"trigger":"Pois","text":"seu brado é de vitória, Aleluia, honra e glória Lhe daremos com amor."}]}]},{"type":"gesture","gestureId":"b50f29acc333","lyrics":[{"trigger":"Como","text":"igreja fiel, Todos unidos a uma voz,"}]},{"type":"gesture","gestureId":"a1ae90ec4622","lyrics":[{"trigger":"Cantaremos","text":"Jesus vem vencedor!"}]},{"type":"repeat","count":2,"children":[{"type":"gesture","gestureId":"f5598e48ef67","lyrics":[{"trigger":"Jesus","text":"vem vencedor!"}]}]}]}