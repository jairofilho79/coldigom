{"schema":"coldigom.gestures/1","title":"62 - É TÃO TRISTE NÃO VER A LUZ (O CEGO BARTIMEU)","dictionaryVersion":0,"items":[{"type":"gesture","gestureId":"b491cbf5c077","lyrics":[{"trigger":"É tão","text":"triste não ver a luz A escuridão dessa vida viver"}]},{"type":"gesture","gestureId":"293061e6b1ce","lyrics":[{"trigger":"À beira","text":"do caminho Bartimeu vivia a sofrer"}]},{"type":"gesture","gestureId":"efe780180e1f","lyrics":[{"trigger":"Mas uma","text":"voz de esperança"}]},{"type":"gesture","gestureId":"4407bea7bf89","lyrics":[{"trigger":"Aos seus","text":"ouvidos um dia chegou"}]},{"type":"gesture","gestureId":"a8f14c24fa84","lyrics":[{"trigger":"A multidão","text":"o impedia"}]},{"type":"gesture","gestureId":"5b15aaadaa96","lyrics":[{"trigger":"E o cego","text":"bem alto gritou: Oh! Jesus, Filho de Davi Tem misericórdia de mim"}]},{"type":"gesture","gestureId":"a1ae90ec4622","lyrics":[{"trigger":"Queria","text":"ver o sol nascer"}]},{"type":"gesture","gestureId":"f4f423093171","lyrics":[{"trigger":"A luz","text":"da vida resplandecer"}]},{"type":"gesture","gestureId":"121dceda600f","lyrics":[{"trigger":"E Jesus","text":"teve compaixão"}]},{"type":"gesture","gestureId":"37f56d504928","lyrics":[{"trigger":"Deu-lhe","text":"cura e redenção"}]},{"type":"gesture","gestureId":"a6a5eb350ad4","lyrics":[{"trigger":"E feliz","text":"pelo caminho a Jesus seguiu."}]},{"type":"instruction","kind":"repeat_praise"}]}