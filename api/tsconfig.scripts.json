{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022"],
    "outDir": "./dist",
    "types": ["node"],
    "moduleDetection": "force"
  },
  "include": ["scripts/**/*"],
  "exclude": ["node_modules"]
}
