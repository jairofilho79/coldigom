{"schema":"coldigom.gestures/1","title":"02 - PAI, ESTOU A TE CLAMAR","dictionaryVersion":0,"items":[{"type":"gesture","gestureId":"121dceda600f","lyrics":[{"trigger":"Pai","text":"estou a te clamar,"},{"trigger":"","text":"Pedindo perdão, socorro,"}]},{"type":"gesture","gestureId":"4407bea7bf89","lyrics":[{"trigger":"Eu","text":"quero te ouvir"}]},{"type":"gesture","gestureId":"121dceda600f","lyrics":[{"trigger":"Pai","text":"ensina-me a adorar"},{"trigger":"","text":"E a glorificar teu nome,"}]},{"type":"gesture","gestureId":"37f56d504928","lyrics":[{"trigger":"Eu","text":"quero te amar."}]},{"type":"gesture","gestureId":"121dceda600f","lyrics":[{"trigger":"Pai","text":"eu quero te servir,"},{"trigger":"","text":"Oh! Dá-me da tua graça"}]},{"type":"gesture","gestureId":"37f56d504928","lyrics":[{"trigger":"E me","text":"bastará, bastará, bastará."}]}]}