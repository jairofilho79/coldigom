name = "coldigom-api"
account_id = "${CLOUDFLARE_ACCOUNT_ID}"
main = "dist/index.js"
compatibility_date = "2025-01-01"
compatibility_flags = ["nodejs_compat"]

# D1 Database binding
[[d1_databases]]
binding = "DB"
database_name = "coldigom"
database_id = "${CLOUDFLARE_DATABASE_ID}"

# R2 Bucket binding
[[r2_buckets]]
binding = "ASSETS"
bucket_name = "coldigom-assets"

# OAuth / sessão (valores públicos). Secrets via: wrangler secret put <NAME>
#   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, AUTH_JWT_SECRET
# Use wrangler global 4.x (não npx wrangler).
[vars]
AUTH_BASE_URL = "https://coldigom-api.coletaneadigitalicm.workers.dev"
WEB_ORIGIN = "https://coldigom-web.pages.dev"
AUTH_COOKIE_SAMESITE = "None"

[dev]
port = 8787
local_protocol = "http"

# Local secrets: copy to .dev.vars (gitignored)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_JWT_SECRET=
