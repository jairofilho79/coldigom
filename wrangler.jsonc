{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coldigom",
  "compatibility_date": "2026-04-21",
  "observability": {
    "enabled": true
  },
  "vars": {
    "VITE_API_URL": "https://coldigom-api.coletaneadigitalicm.workers.dev"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "pages_build_output_dir": "web/dist"
}
